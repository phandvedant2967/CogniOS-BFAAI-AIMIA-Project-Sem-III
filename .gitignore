.env.*
*.secret
secrets/
*.pem
*.key
*.p12
*.pfx

# ── Python cache & bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
virtualenv/
.virtualenv/
pipenv/

